# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Postgres (Project Settings → Database → Connection string → "Session pooler") ---
# Use the SESSION pooler string (port 5432) for both. If your password has special
# characters (@ : / ?) URL-encode them.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Rootly AI (optional — Rootly still answers from plants.json without it) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
